# From @BotFather
TELEGRAM_BOT_TOKEN=
# From https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Optional: a second Last.fm key for unsigned calls, so the key shown in login URLs can't burn your rate limit
LASTFM_PRIVATE_KEY=
# SQLite by default; for Postgres: postgresql+asyncpg://user:pass@host/fmbot
DATABASE_URL=sqlite+aiosqlite:///fmbot.db
WHOKNOWS_MAX_MEMBERS=100
# Optional: nicknames per group chat, usable in every command, as JSON on one line: {"<chat id>": {"<nickname>": "<Last.fm username>"}}
# e.g. FM_ALIASES={"-1001234567890": {"alex": "alexlfm", "sam": "samplays"}}
FM_ALIASES=
# Optional: a URL or email MusicBrainz can reach you at; it's sent with artist country lookups
MUSICBRAINZ_CONTACT=
# Optional: exact Spotify links (a Spotify developer app; Spotify now requires its owner to have Premium)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: exact YouTube links (a YouTube Data API v3 key from Google Cloud)
YOUTUBE_API_KEY=
